# ======================================================================
# FILAO NETWORKS SOLUTIONS - PRODUCTION .HTACCESS
# 1) SEO-Friendly Clean URLs (Removes .php like WordPress)
# 2) Gzip/Deflate Compression for ultra-fast loading
# 3) Long-term Browser Caching & Performance Headers
# ======================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ----------------------------------------------------------------------
    # 1. SEO FRIENDLY BLOG URLS (WordPress-style slugs)
    # ----------------------------------------------------------------------
    # /blogs/some-slug -> /blogs/post.php?slug=some-slug
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^blogs/([a-zA-Z0-9_-]+)/?$ blogs/post.php?slug=$1 [L,QSA]

    # /blog/some-slug -> /blogs/post.php?slug=some-slug (Singular alias)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ blogs/post.php?slug=$1 [L,QSA]

    # ----------------------------------------------------------------------
    # 2. REMOVE .php EXTENSIONS (Clean WordPress-style URLs)
    # ----------------------------------------------------------------------
    # Canonical 301 Redirect: if a visitor/search engine requests file.php (GET only),
    # redirect to clean URL without .php to prevent duplicate content SEO penalties
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^ %1 [R=301,L]

    # Internally rewrite clean URLs back to matching .php files if they exist
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>

# ======================================================================
# 3. GZIP / DEFLATE COMPRESSION (Maximized Load Speed)
# ======================================================================
<IfModule mod_deflate.c>
    # Compress HTML, CSS, JavaScript, JSON, XML, and SVG files
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ======================================================================
# 4. BROWSER CACHING & EXPIRES HEADERS (Instant Subsequent Page Loads)
# ======================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Images & Favicons (1 Year)
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts (1 Year)
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

    # CSS and JavaScript (1 Month)
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"

    # HTML & Data (1 Hour for freshness)
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType application/json "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
    # Add Cache-Control header for static files
    <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|svg|css|js|woff2|woff|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Disable ETags to reduce overhead
    Header unset ETag
    FileETag None

    # Security headers
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
